{
  "expo": {
    "name": "UniControl",
    "slug": "UniControl",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/App.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Carga.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/App.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.castelbrothers.unicontrol",
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/Navegador.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "5d2bf488-53c6-46fd-945c-c5ff4a5b20cd"
      }
    },
    "owner": "castelbrothersfamily"
  }
}
