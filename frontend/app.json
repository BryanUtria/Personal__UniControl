{
  "expo": {
    "name": "UniControl",
    "slug": "UniControl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/App.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Carga.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/App.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bryansicte.UniControl"
    },
    "web": {
      "favicon": "./assets/Navegador.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ]
  }
}
